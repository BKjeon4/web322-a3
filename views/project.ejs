<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title><%= project.title %></title>

    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.4.14/dist/full.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-base-100">

<%- include("partials/navbar") %>

<div class="container mx-auto px-6 py-10">

    <a href="/solutions/projects" class="btn btn-sm mb-6">← Back to Projects</a>

    <div class="grid md:grid-cols-2 gap-10">

        <!-- IMAGE -->
        <div>
            <img 
                src="<%= project.feature_img_url %>" 
                alt="<%= project.title %>" 
                class="rounded-xl shadow-lg w-full object-cover"
            />
        </div>

        <!-- TEXT -->
        <div>
            <h1 class="text-3xl font-bold mb-4"><%= project.title %></h1>

            <p class="text-sm opacity-60 mb-3">
                Sector: <span class="font-semibold"><%= project.sector %></span>
            </p>

            <p class="text-lg leading-relaxed mb-4">
                <%= project.intro_short %>
            </p>

            <p class="text-md leading-relaxed mb-6">
                <%= project.impact %>
            </p>

            <!-- BUTTON AREA -->
            <div class="flex gap-4 mt-6">

                <!-- View Source -->
                <a 
                    href="<%= project.original_source_url %>"
                    class="btn btn-primary"
                    target="_blank"
                >
                    View Source →
                </a>

                <!-- ADMIN ONLY BUTTONS -->
                <% if (session.user) { %>

                    <a 
                        href="/solutions/editProject/<%= project.id %>" 
                        class="btn btn-warning"
                    >
                        Edit
                    </a>

                    <a 
                        href="/solutions/deleteProject/<%= project.id %>" 
                        class="btn btn-error"
                        onclick="return confirm('Are you sure you want to delete this project?');"
                    >
                        Delete
                    </a>

                <% } %>

            </div>
        </div>

    </div>

</div>

</body>
</html>
