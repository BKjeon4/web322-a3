<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Edit Project</title>

    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.4.14/dist/full.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>

<%- include('partials/navbar') %>

<div class="container mx-auto p-6">
    <h1 class="text-3xl font-bold mb-6">Edit Project</h1>

    <form action="/solutions/editProject" method="POST" class="space-y-4">

        <input type="hidden" name="id" value="<%= project.id %>">

        <input type="text" name="title" value="<%= project.title %>" class="input input-bordered w-full" required>

        <input type="text" name="feature_img_url" value="<%= project.feature_img_url %>" class="input input-bordered w-full" required>

        <select name="sector_id" class="select select-bordered w-full">
            <option value="1" <%= project.sector_id == 1 ? 'selected' : '' %>>Land Sinks</option>
            <option value="2" <%= project.sector_id == 2 ? 'selected' : '' %>>Industry</option>
            <option value="3" <%= project.sector_id == 3 ? 'selected' : '' %>>Transportation</option>
            <option value="4" <%= project.sector_id == 4 ? 'selected' : '' %>>Electricity</option>
            <option value="5" <%= project.sector_id == 5 ? 'selected' : '' %>>Food, Agriculture, and Land Use</option>
        </select>

        <textarea name="summary_short" class="textarea textarea-bordered w-full"><%= project.summary_short %></textarea>
        <textarea name="intro_short" class="textarea textarea-bordered w-full"><%= project.intro_short %></textarea>
        <textarea name="impact" class="textarea textarea-bordered w-full"><%= project.impact %></textarea>

        <input type="text" name="original_source_url" value="<%= project.original_source_url %>" class="input input-bordered w-full" required>

        <button class="btn btn-primary w-full">Save Changes</button>
    </form>
</div>

</body>
</html>
