<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Add Project</title>

    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.4.14/dist/full.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>

<%- include('partials/navbar') %>

<div class="container mx-auto p-6">
    <h1 class="text-3xl font-bold mb-6">Add New Project</h1>

    <form action="/solutions/addProject" method="POST" class="space-y-4">

        <input type="text" name="title" placeholder="Title" class="input input-bordered w-full" required>

        <input type="text" name="feature_img_url" placeholder="Feature Image URL" class="input input-bordered w-full" required>

        <select name="sector_id" class="select select-bordered w-full">
            <option value="1">Land Sinks</option>
            <option value="2">Industry</option>
            <option value="3">Transportation</option>
            <option value="4">Electricity</option>
            <option value="5">Food, Agriculture, and Land Use</option>
        </select>

        <textarea name="summary_short" class="textarea textarea-bordered w-full" placeholder="Summary" required></textarea>
        <textarea name="intro_short" class="textarea textarea-bordered w-full" placeholder="Intro" required></textarea>
        <textarea name="impact" class="textarea textarea-bordered w-full" placeholder="Impact" required></textarea>

        <input type="text" name="original_source_url" placeholder="Original Source URL" class="input input-bordered w-full" required>

        <button class="btn btn-primary w-full">Add Project</button>
    </form>
</div>

</body>
</html>
